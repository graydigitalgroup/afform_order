<?php

namespace Civi\AfformOrder;

use Civi\AfformOrder\Event\OrderCreatedEvent;
use Civi\Api4\LineItem;
use Civi\Core\Service\AutoSubscriber;

/**
 * Apply per-line explicit membership dates to the records Order.create just
 * produced, freezing status so completion's date-set short-circuit fires.
 *
 * When a staff member edits a membership line in the cart's per-line modal and
 * sets explicit start_date / end_date, those values ride along on the line as
 * private cart keys (`_start_date`, `_end_date`) through Submit::buildLineItems,
 * surviving until OrderCreatedEvent fires here. They are NOT applied via
 * `entity_id.<field>` on Order.create itself: the APIv4 Membership.create path
 * Order uses forces version=4 to bypass date math, so the pending membership
 * lands with placeholder/empty dates; we want them set explicitly on the
 * resulting record so that core's Civi\Membership\OrderCompleteSubscriber sees
 *   empty(end_date) || status_id:name !== 'Pending'
 * evaluate to FALSE on completion and SKIP its num_terms-driven date
 * recalculation, preserving the dates as written.
 *
 * Hence this seam: between Order.create (priority 0) and the native Afform
 * checkout (priority -100), afform_order dispatches OrderCreatedEvent so we
 * can write the dates directly on the membership(s) before any payment fires.
 *
 * Why both skipStatusCal=1 AND is_override=1:
 *  - skipStatusCal=1 stops the BAO at this call from running status calc on
 *    the dates we're writing. Without it, status flips Pending -> New as soon
 *    as the BAO sees dates that make the membership look "active in first
 *    term" -- and completion's IF then fires because status !== 'Pending'.
 *  - is_override=1 freezes the status against ANY subsequent recalc that may
 *    fire between our write and completion: Job_UpdateMembership cron runs,
 *    hooks on related contribution/membership saves, other extension hooks.
 *    OrderCompleteSubscriber explicitly resets is_override=FALSE and
 *    status_override_end_date='null' before re-recalculating status from the
 *    (preserved) dates, so end state matches CRM_Member_Form_Membership's
 *    behaviour exactly.
 *
 * Matching cart-carried lines to created memberships:
 *   1. Walk the OrderCreatedEvent's lineItems (which still carry private keys)
 *      and collect the per-line dates keyed by price_field_value_id.
 *   2. Query LineItem rows for the saved contribution to resolve each
 *      price_field_value_id to its created membership id (entity_id).
 *   3. APIv3 Membership.create with id + dates + skipStatusCal + is_override.
 * Same-type prevention in the UI keeps price_field_value_id unique among
 * membership lines in a single cart, so the keyed map is unambiguous.
 *
 * APIv3 (not v4) because skipStatusCal is an APIv3-specific control flag.
 *
 * Failures are logged via Civi::log()->error() and not re-thrown, so a
 * date-write problem on one membership cannot block the order create / payment
 * pipeline for the contribution as a whole.
 */
class MembershipPostCreateSubscriber extends AutoSubscriber {

  public static function getSubscribedEvents(): array {
    return [
      OrderCreatedEvent::NAME => 'applyExplicitDates',
    ];
  }

  public function applyExplicitDates(OrderCreatedEvent $event): void {
    // Collect cart-carried explicit dates, keyed by PriceFieldValue id.
    $datesByPfv = [];
    foreach ($event->getLineItems() as $line) {
      if (($line['entity_table'] ?? NULL) !== 'civicrm_membership') {
        continue;
      }
      $pfvId = (int) ($line['price_field_value_id'] ?? 0);
      if (!$pfvId) {
        continue;
      }
      $update = [];
      if (!empty($line['_start_date'])) {
        $update['start_date'] = $line['_start_date'];
      }
      if (!empty($line['_end_date'])) {
        $update['end_date'] = $line['_end_date'];
      }
      if ($update) {
        $datesByPfv[$pfvId] = $update;
      }
    }
    if (!$datesByPfv) {
      return;
    }

    // Resolve those PriceFieldValue ids to the memberships Order.create produced.
    $savedLines = LineItem::get(FALSE)
      ->addSelect('entity_id', 'price_field_value_id')
      ->addWhere('contribution_id', '=', $event->getContributionId())
      ->addWhere('entity_table', '=', 'civicrm_membership')
      ->addWhere('price_field_value_id', 'IN', array_keys($datesByPfv))
      ->execute();

    foreach ($savedLines as $row) {
      $pfvId = (int) $row['price_field_value_id'];
      $membershipId = (int) ($row['entity_id'] ?? 0);
      if (!$membershipId || empty($datesByPfv[$pfvId])) {
        continue;
      }
      try {
        // See class docblock for the skipStatusCal + is_override reasoning.
        civicrm_api3('Membership', 'create', array_merge(
          [
            'id' => $membershipId,
            'skipStatusCal' => 1,
            'is_override' => 1,
          ],
          $datesByPfv[$pfvId]
        ));
      }
      catch (\Exception $e) {
        \Civi::log()->error(
          'afform_order post-create membership date update failed (membership id {id}): {msg}',
          ['id' => $membershipId, 'msg' => $e->getMessage()]
        );
      }
    }
  }

}
